    {
      "name": "1. CRUD ventas (tabla principal)",
      "item": [
        {
          "name": "CREATE - Registrar venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ventas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "description": "Vende el Chevrolet Tracker (id 4) al cliente 3. No se envía el precio: la API toma el del inventario y marca el vehículo como Vendido. Guarda el id en id_venta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_factura\": \"FV-OF-2026-0013\",\n  \"metodo_pago\": \"Contado\",\n  \"id_cliente\": 3,\n  \"id_vehiculo\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "pm.test('Formato JSON de la API', () => pm.expect(pm.response.json()).to.have.property('ok'));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('id_venta', j.datos.id_venta);",
                  "pm.test('Precio tomado del inventario', () => pm.expect(j.datos.precio_vehiculo).to.eql(112500000));"
                ]
              }
            }
          ]
        },
        {
          "name": "READ - Listar ventas",
