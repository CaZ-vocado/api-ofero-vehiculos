            "description": "Parámetro de consulta: ?metodo_pago=Contado"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Formato JSON de la API', () => pm.expect(pm.response.json()).to.have.property('ok'));",
                  "pm.test('Solo ventas de contado', () => pm.response.json().datos.forEach(v => pm.expect(v.metodo_pago).to.eql('Contado')));"
                ]
              }
            }
