# Copia este archivo como .env y llena tus datos (el .env NUNCA se sube a GitHub)

# Puerto local de la API
PORT=3000

# Conexión a MySQL en Clever Cloud
# En Clever Cloud: tu add-on MySQL → "Add-on dashboard" → copia cada valor:
#   DB_HOST = MYSQL_ADDON_HOST     DB_PORT = MYSQL_ADDON_PORT
#   DB_USER = MYSQL_ADDON_USER     DB_PASSWORD = MYSQL_ADDON_PASSWORD
#   DB_NAME = MYSQL_ADDON_DB
DB_HOST=bxxxxxxxxxxxxxxx-mysql.services.clever-cloud.com
DB_PORT=3306
DB_USER=uxxxxxxxxxxxxxxx
DB_PASSWORD=tu_contrasena
DB_NAME=bxxxxxxxxxxxxxxx

# El plan gratis de Clever Cloud permite 5 conexiones a la vez: la API usa 3
DB_CONNECTION_LIMIT=3

# Clever Cloud no exige SSL
DB_SSL=false
DB_SSL_CA=
